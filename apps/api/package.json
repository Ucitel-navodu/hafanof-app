{
  "name": "hafanof-api",
  "version": "1.0.0",
  "private": true,
  "description": "Hafanof evidence API (milestone 1)",
  "type": "commonjs",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "seed": "tsx scripts/seed.ts",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "docx": "^9.15.4",
    "docxtemplater": "^3.71.1",
    "exceljs": "^4.4.0",
    "express": "^4.22.3",
    "multer": "^2.5.0",
    "nodemailer": "^10.5.0",
    "pizzip": "^3.3.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/yazl": "^3.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
